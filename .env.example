# Local Investment Copilot. Copy this file to .env and restart the dev server.
# These names are read only by the local API. Do not prefix them with VITE_.
COPILOT_PROVIDER=openai
COPILOT_API_KEY=
COPILOT_MODEL=
# COPILOT_BASE_URL=https://api.openai.com/v1

# GitHub Actions sets this for the public Pages build. Leave it unset locally.
# VITE_COPILOT_DEMO=true
